/**
 * The control panel: a static Angular build served by Cloudflare Workers
 * static assets. There is no Worker script; headers come from public/_headers.
 *
 * `pnpm --filter @speakukrainian/admin run deploy` builds and deploys it (`run`
 * is needed: `pnpm deploy` on its own is a different, built-in command).
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "speakukrainian-admin",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "admin.speakukrainian.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist/admin/browser",
    // Client-side routes: any path that is not a file gets index.html.
    "not_found_handling": "single-page-application",
  },
}
