{
  "name": "@speakukrainian/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "smoke": "wrangler dev --config smoke/wrangler.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist --containers-rollout=none",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint src smoke test --max-warnings 0",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply speakukrainian --local",
    "db:migrate:remote": "wrangler d1 migrations apply speakukrainian --remote"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.167.0",
    "@types/node": "^24.10.1"
  }
}
