/**
 * The gateway Worker: the public entry point for speakukrainian.org.
 *
 * It owns the API container (one Durable Object instance) and the Cloudflare
 * bindings the API cannot use from inside a container. See src/index.ts.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "speakukrainian-gateway",
  "main": "src/index.ts",
  // `ctx.exports`, used to hand the bridge to the container, needs 2025-11-17
  // or later.
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "speakukrainian.org", "custom_domain": true }],
  "observability": { "enabled": true },

  // Once a day, 08:00 UTC: the gateway asks the API to send chat reminders
  // (src/cron.ts). Needs the CRON_SECRET secret: `wrangler secret put CRON_SECRET`.
  "triggers": { "crons": ["0 8 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speakukrainian",
      "database_id": "bc4c5342-0efc-498a-b17c-52aa3d77ade0",
      "migrations_dir": "migrations",
    },
  ],

  // H5P content, libraries and temporary uploads. Private: no public bucket
  // URL, no custom domain; files are only ever served by the API.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "speakukrainian-h5p" }],

  // Cloudflare Email Sending. The domain is onboarded in the dashboard
  // (Email Service > Email Sending); this binding may only send as no-reply.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@speakukrainian.org"] }],

  // Tells the container's Durable Object which deploy it belongs to, so it
  // can replace a container started by an earlier one (src/api-container.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "containers": [
    {
      "class_name": "ApiContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../api/Dockerfile", "build_context": "../.." },
      },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "ApiContainer" }],
  },
  "exports": {
    "ApiContainer": { "type": "durable-object", "storage": "sqlite" },
  },

  "vars": {
    "NODE_ENV": "production",
    // Everything here is passed on to the API container as its environment
    // (see ApiContainer.containerEnv), together with the Worker secrets:
    // AUTH_SECRET, H5P_URL_TOKEN_SECRET, CRON_SECRET, ADMIN_EMAIL and, once
    // payments are live, STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET.
    "PUBLIC_SITE_URL": "https://speakukrainian.org",
    "ADMIN_APP_URL": "https://admin.speakukrainian.org",
    "STUDENT_APP_URL": "https://student.speakukrainian.org",
    "CORS_ORIGINS": "https://admin.speakukrainian.org,https://student.speakukrainian.org",
    "H5P_BASE_URL": "https://speakukrainian.org/api/h5p",
    "EMAIL_DELIVERY": "send",
    "EMAIL_FROM": "SpeakUkrainian <no-reply@speakukrainian.org>",
  },

  // `pnpm dev` runs the API as a plain Node process, so the container is not
  // built or started locally and Docker is not needed. `.dev.vars` switches the
  // Worker to local mode (see .dev.vars.example).
  "dev": { "port": 8787, "enable_containers": false },
}
