# Copy to .env and fill in.
NODE_ENV=development
PORT=8080

# --- Database and files (Cloudflare D1 and R2, through the gateway) -----------
# `pnpm dev` runs the gateway on :8787. BRIDGE_SECRET must match the one in
# apps/gateway/.dev.vars. Neither is set by hand in production.
BRIDGE_URL=http://localhost:8787/__bridge
BRIDGE_SECRET=local-bridge-secret

# --- Authentication (better-auth) --------------------------------------------
# Signs session tokens. At least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=

# --- URLs -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
PUBLIC_SITE_URL=http://localhost:8080
STUDENT_APP_URL=http://localhost:4300
ADMIN_APP_URL=http://localhost:4200
H5P_BASE_URL=http://localhost:8080/api/h5p

# --- Production only (docker-compose.prod.yml) --------------------------------
# Apex domain. The stack serves DOMAIN, admin.DOMAIN and student.DOMAIN, and
# derives every URL above from it.
DOMAIN=

# --- Admin ------------------------------------------------------------------
# The single administrator. Created on first boot with the default password
# `admin123`; change it in the panel.
ADMIN_EMAIL=admin@example.com

# --- H5P --------------------------------------------------------------------
# At least 32 random characters: `openssl rand -base64 48`
H5P_URL_TOKEN_SECRET=

# --- Stripe (optional in development: purchases complete instantly) ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SendGrid (optional in development: emails are logged) ------------------
SENDGRID_API_KEY=
EMAIL_FROM="SpeakUkrainian <no-reply@example.com>"
CHAT_REMINDER_AFTER_HOURS=24
