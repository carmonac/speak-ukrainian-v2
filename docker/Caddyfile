# Reverse proxy and automatic HTTPS for the three public hosts.
# DOMAIN comes from the environment (see docker-compose.prod.yml).

{$DOMAIN} {
	encode zstd gzip
	# The public site and the API (/api/*) are the same NestJS process.
	reverse_proxy api:8080
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

admin.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:8080
}

student.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy student:8080
}
